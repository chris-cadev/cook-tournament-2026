+// GET /api/chat/global/messages (public, but useful for admin moderation)
+router.get('/global/messages', (req: AuthRequest, res) => {
+  const limit = Math.min(parseInt(req.query.limit as string) || 50, 100);
+  const before = req.query.before as string | undefined;
+
+  const db = getDb();
+  let messages;
+  if (before) {
+    messages = db.prepare(
+      'SELECT * FROM chat_messages WHERE channel = ? AND id < ? ORDER BY created_at DESC LIMIT ?'
+    ).all('global', before, limit);
+  } else {
+    messages = db.prepare(
+      'SELECT * FROM chat_messages WHERE channel = ? ORDER BY created_at DESC LIMIT ?'
+    ).all('global', limit);
+  }
+
+  res.json({ messages: messages.reverse() });
+});
+
+// GET /api/chat/teams (list all teams for admin moderation)
+router.get('/teams', requireAdmin, (_req: AuthRequest, res) => {
+  const db = getDb();
+  const teams = db.prepare('SELECT id, name FROM teams ORDER BY name').all();
+  res.json({ teams });
+});
