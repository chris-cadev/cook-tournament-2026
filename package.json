{
  "name": "cook-tournament-2026",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "eslint backend/src/ frontend/src/",
    "db:reset": "npm run reset -w backend",
    "db:reset:docker": "docker compose rm -fsv backend && docker volume rm cook-2026_backend-data; docker compose up -d backend",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.9.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
